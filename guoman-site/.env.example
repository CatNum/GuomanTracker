# CloudBase 环境 ID（公开标识），上线时替换占位符
NEXT_PUBLIC_CLOUDBASE_ENV_ID=YOUR_CLOUDBASE_ENV_ID
NEXT_PUBLIC_CLOUDBASE_REGION=ap-shanghai
# 公共PG目录的HTTP网关地址（公开配置；路径为 /api/catalog）
NEXT_PUBLIC_CATALOG_URL=https://YOUR_GATEWAY_DOMAIN/api/catalog
# CloudBase 可发布密钥（账号认证初始化使用），不是服务器 SecretKey
NEXT_PUBLIC_CLOUDBASE_PUBLISHABLE_KEY=YOUR_CLOUDBASE_PUBLISHABLE_KEY
# 微信 AppSecret 仅在 CloudBase 控制台配置，切勿填写为 NEXT_PUBLIC_*。
