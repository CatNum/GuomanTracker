{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "envId": "YOUR_CLOUDBASE_ENV_ID",
  "functionRoot": "./.cloudbase-deploy",
  "functions": [
    {
      "name": "guoman-user",
      "handler": "index.main",
      "runtime": "Nodejs24.11",
      "timeout": 30,
      "memorySize": 256,
      "installDependency": false,
      "ignore": [
        ".env*"
      ]
    },
    {
      "name": "guoman-catalog",
      "handler": "index.main",
      "runtime": "Nodejs24.11",
      "timeout": 30,
      "memorySize": 256,
      "installDependency": false,
      "ignore": [
        ".env*"
      ]
    },
    {
      "name": "guoman-scan",
      "handler": "index.main",
      "runtime": "Nodejs24.11",
      "timeout": 120,
      "memorySize": 256,
      "installDependency": false,
      "ignore": [
        ".env*"
      ],
      "envVariables": {
        "GUOMAN_SCAN_SECRET": "{{env.GUOMAN_SCAN_SECRET}}"
      }
    }
  ]
}
